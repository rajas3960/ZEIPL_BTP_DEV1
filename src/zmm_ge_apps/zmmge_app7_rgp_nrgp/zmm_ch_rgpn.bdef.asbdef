projection;
strict ( 2 );
use draft;
use side effects;

define behavior for ZMM_CH_RGPN alias Header
{
  use create;
  use update;
  use delete;

  use action AddMaterial;
  use action PrintPreview;

  use action Resume;
  use action Edit;
  use action Activate;
  use action Discard;
  use action Prepare;

  use association _Item { create; with draft; }
}

define behavior for ZMM_CI_RGPN alias Item
{
  use update;
  use delete;

  use association _Header { with draft; }
}