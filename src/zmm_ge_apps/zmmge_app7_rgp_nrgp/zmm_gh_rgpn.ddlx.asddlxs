  @UI: { lineItem:       [{ position: 50, importance: #HIGH }],
         selectionField: [{ position: 70 }],
         fieldGroup:     [{ qualifier: 'Transport', position: 10 }],
         dataPoint:      { qualifier: 'Vehicle', title: 'Vehicle' } }
  @EndUserText.label: 'Vehicle No.'
  Vehicleno;
  @UI.fieldGroup: [{ qualifier: 'Transport', position: 20 }]
  @EndUserText.label: 'Vehicle Type'
  Vehicletype;
  @UI.fieldGroup: [{ qualifier: 'Transport', position: 30 }]
