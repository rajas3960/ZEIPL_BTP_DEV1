@Metadata.layer: #CUSTOMER
@UI: {
  headerInfo: { typeName: 'Material',
                typeNamePlural: 'Materials',
                title:       { type: #STANDARD, value: 'Matnr' },
                description: { type: #STANDARD, value: 'Maktx' } },
  presentationVariant: [{ sortOrder: [{ by: 'Itemno', direction: #ASC }] }]
}
@UI.createHidden: true
annotate entity ZMM_CI_RGPN with
{
  @UI.facet: [
    { id: 'Item',   type: #FIELDGROUP_REFERENCE, targetQualifier: 'Item',   label: 'Material', position: 10 },
    { id: 'Return', type: #FIELDGROUP_REFERENCE, targetQualifier: 'Return', label: 'Returns',  position: 20 }
  ]

  @UI.hidden: true
  Itemuuid;
  @UI.hidden: true
  Gpuuid;

  @UI: { lineItem:   [{ position: 10, importance: #HIGH }],
         fieldGroup: [{ qualifier: 'Item', position: 10 }] }
  @EndUserText.label: 'Item'
  Itemno;
  @UI: { lineItem:   [{ position: 20, importance: #HIGH }],
         fieldGroup: [{ qualifier: 'Item', position: 20 }] }
  @EndUserText.label: 'Material'
  Matnr;
  @UI: { lineItem:   [{ position: 30 }],
         fieldGroup: [{ qualifier: 'Material', position: 30 }] }
         
  @EndUserText.label: 'Plant'
  Plant;
  @UI: { lineItem:   [{ position: 40 }],
         fieldGroup: [{ qualifier: 'Item', position: 40 }] }
         @Consumption.valueHelpDefinition: [ { entity: { name: 'ZSD_SLOC_VH', element: 'Storagelocation' },
                                      additionalBinding: [ { localElement: 'Plant', element: 'Plant', usage: #FILTER } ] } ]
  @EndUserText.label: 'Storage Location'
  Storagelocation;
  @UI: { lineItem:   [{ position: 50 }],
         fieldGroup: [{ qualifier: 'Item', position: 50 }] }
  @EndUserText.label: 'HSN/SAC'
  Hsncode;
  @UI: { lineItem:   [{ position: 60 }],
         fieldGroup: [{ qualifier: 'Item', position: 60 }] }
  @EndUserText.label: 'Tax Code'
  Taxcode;
  @UI: { lineItem:   [{ position: 70, importance: #HIGH }],
         fieldGroup: [{ qualifier: 'Item', position: 70 }] }
  @EndUserText.label: 'Quantity'
  Quantity;
  @UI: { lineItem:   [{ position: 80 }],
         fieldGroup: [{ qualifier: 'Item', position: 80 }] }
  @EndUserText.label: 'Rate'
  Netprice;
  @UI: { lineItem:   [{ position: 90, importance: #HIGH }],
         fieldGroup: [{ qualifier: 'Item', position: 90 }] }
  @EndUserText.label: 'Value'
  Totvalue;
  @UI: { lineItem:   [{ position: 100 }],
         fieldGroup: [{ qualifier: 'Item', position: 100 }] }
  @EndUserText.label: 'Remarks'
  Remarks;

  @UI.fieldGroup: [{ qualifier: 'Return', position: 10 }]
  @EndUserText.label: 'Received Qty'
  Totrcvqty;
  @UI.fieldGroup: [{ qualifier: 'Return', position: 20 }]
  @EndUserText.label: 'Accepted Qty'
  Totaccqty;
  @UI.fieldGroup: [{ qualifier: 'Return', position: 30 }]
  @EndUserText.label: 'Rejected Qty'
  Totrjtqty;
  @UI: { lineItem:   [{ position: 110 }],
         fieldGroup: [{ qualifier: 'Return', position: 40 }] }
  @EndUserText.label: 'Open Qty'
  Totopnqty;
  @UI.fieldGroup: [{ qualifier: 'Return', position: 50 }]
  @EndUserText.label: 'Closed'
  Closed;

  @UI.hidden: true
  Locallastchangedat;
}