managed implementation in class zbp_mmge_app2_re unique;
strict ( 2 );
with draft;

define behavior for ZMMGE_APP2_RE alias GateHead
persistent table zmmge_hdr_t01
draft table zmmge_app2_re_dt
with additional save
lock master
total etag Lastchangedat
authorization master ( instance )
etag master Lastchangedat
{
  update ( features : instance );
  //   create /
  delete ( features : instance );
  //   owned by the Gate Entry app (ZMMGE_APP1_RE)

  field ( readonly ) Uuid;
  field ( readonly ) Gateentrydate, Gateentryid, Gateentryiddate, Gateentryno, Gateentryseqno,
  Gateentryseries, Gateentryseriesdes, Gateentrytime, Gateno, Gatenodes, MigoStatus;
  field ( readonly ) Plant, Plantname, Materialdocument, Materialdocumentyear;
  field ( readonly ) Referno, Referdate, Challanno, Challandate, Entryslipattcmt, Entryfilename,
  Erpreferenceno, Entrymimetype, Experiredt, Securityremarks, Weighmentindicator;
  field ( readonly ) CheckInStatus, GateEntryStatus, Overallstatus, Criticality, Defaultfilter,
  Createdby, Createdat, Lastchangedby, Lastchangedat, Transportername, Trasportername;

  association _Item { create; with draft; }

  draft action ( features : instance ) Edit;
  draft action Activate optimized;
  draft action Resume;
  draft action Discard;
  draft determine action Prepare
  {
    determination ( always ) GateItem~sumChallans;
    validation GateItem~checkFreightOrder;
    validation GateChallan~checkChallan;
    validation GateItem~checkG1Item;
  }

  action ( features : instance ) Purchase deep parameter ZPO_INPUT result [1] $self;
  action ( features : instance ) GateCheckIn result [1] $self;
  action ( features : instance ) WeightScrn result [1] $self;
  action ( features : instance ) MigoPost parameter ZMM_MIGO_INPUT result [1] $self;
  action ( features : instance ) GateSlipForm result [1] $self;

  side effects
  {
    action Purchase affects $self, entity _Item;
    action GateCheckIn affects $self;
    action GateSlipForm affects $self;
  }

  mapping for zmmge_hdr_t01 corresponding;
}

define behavior for ZMMGE_APP2_IV1 alias GateItem
persistent table zmmge_itm_t01
draft table zmmge_itm_t01d
lock dependent by _Head
authorization dependent by _Head
etag master Lastchangedat
{
  update ( features : instance );
  delete ( features : instance );

  field ( readonly ) Uuid;
  field ( readonly ) Purchaseorder, Purchaseorderitem, Challannetweight, Materialgroup, Gateentryno, Subgateentryno;
  field ( readonly ) Material, Materialtext, Plant, Plantname, Vendor, Suppliername, Baseunit, Grnqty, Inbounddelivery,
  Quantity, Netweight, Poordertype, Poordertypetext, Orderdate, Gateentryseries, Weightindicator;
  field ( readonly ) Createdby, Createdat, Lastchangedby, Lastchangedat;
  field ( readonly ) Carrier, Carriername, Incoterms;
  // challan totals of the challan lines (P6a)
  field ( readonly ) Challanqty, Chqtyunit, Challantareweight, Challangrossweight, Chbaseunit,
  Challanno, Challandate, Trasporterid, Lrno, Lrdate, Chdocumt;
  field ( mandatory ) Freightorder;

  association _Head { with draft; }
  association _Challan { create ( features : instance ); with draft; }

  determination fillCarrier on modify { field Freightorder; }
  determination sumChallans on save { create; }
  validation checkFreightOrder on save { create; field Freightorder; }
  validation checkG1Item on save { create; field Challanqty, Chqtyunit, Materialgroup; }

  side effects
  {
    field Freightorder affects field Carrier, field Carriername;
  }

  action ( features : instance ) InbDelivery result [1] $self;

  mapping for zmmge_itm_t01 corresponding;
}

define behavior for ZMMGE_APP2_IC1 alias GateChallan
persistent table zmmge_chln_t01
draft table zmmge_chln_t01d
lock dependent by _Head
authorization dependent by _Head
etag master Lastchangedat
{
  update;
  delete;

  field ( readonly, numbering : managed ) Chlnuuid;
  field ( readonly ) Uuid, Purchaseorder, Purchaseorderitem, Subgateentryno,
  Challannetweight, Chqtyunit, Trasportername,
  Createdby, Createdat, Lastchangedby, Lastchangedat;
  field ( mandatory ) Challanno, Challandate, Challanqty;

  association _Head { with draft; }
  association _Item { with draft; }

  determination fillChallan on modify { create; field Challangrossweight, Challantareweight; }
  determination totalToItem on modify { create; field Challanqty, Challantareweight, Challangrossweight, Challannetweight; }
  determination setSubGate on save { create; field Challanno; }

  validation checkChallan on save { create; field Challanno, Challandate, Challanqty; }

  side effects
  {
    field Challangrossweight affects field Challannetweight, entity _Item;
    field Challantareweight affects field Challannetweight, entity _Item;
    field Challanqty affects entity _Item;
  }

  mapping for zmmge_chln_t01 corresponding;
}