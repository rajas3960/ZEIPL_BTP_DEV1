        title: {
            type: #STANDARD,
            label: 'RGP NRGP Outstanding Report',
            value: 'Gpno'
        }
    },
    presentationVariant: [{
        sortOrder: [{
            by: 'Gpno',
            direction: #DESC
        }]
    }]
}

annotate entity ZMM_RGP_NRGP_CV
