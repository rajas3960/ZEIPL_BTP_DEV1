  @UI.fieldGroup: [ { qualifier: 'Weigh', position: 40, label: 'Weighment Time' } ]
  Weighmenttime;

  @UI.fieldGroup: [ { qualifier: 'Weigh', position: 50, label: 'Unloading Finished' } ]
  Unloadendindi;

  @UI.lineItem: [ { position: 50, label: 'Pending Stage' } ]
  @UI.fieldGroup: [ { qualifier: 'Status', position: 10, label: 'Pending Stage' } ]
  Pendingstagetext;

  @UI.hidden: true
  Pendingstage;
  
  @UI.hidden: true
  @UI.selectionField: [ { position: 10 } ]
  @EndUserText.label: 'Pending Only (X)'
  Ispending;

  @UI.lineItem: [ { position: 55, label: 'Gross Images', criticality: 'Imgcritgross' } ]
  @UI.fieldGroup: [ { qualifier: 'Status', position: 20, label: 'Gross Images', criticality: 'Imgcritgross' },
                    { qualifier: 'Verify', position: 10, label: 'Gross Images', criticality: 'Imgcritgross' } ]
  Imgstatusgrosstext;

  @UI.lineItem: [ { position: 60, label: 'Tare Images', criticality: 'Imgcrittare' } ]
