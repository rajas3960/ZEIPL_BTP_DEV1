  @UI.fieldGroup: [ { qualifier: 'Verify', position: 50, label: 'Reject Reason' } ]
  Imgrejreason;

  @UI.fieldGroup: [ { qualifier: 'Verify', position: 60, label: 'Verified By' } ]
