@Metadata.layer: #CUSTOMER
@UI: { headerInfo: { typeName: 'Inward Image Verification',
                     typeNamePlural: 'Inward Image Verification',
                     title: { type: #STANDARD, value: 'Gateentryno' },
                     description: { type: #STANDARD, value: 'Vehicleno' } },
       presentationVariant: [ { sortOrder: [ { by: 'Gateentrydate', direction: #DESC } ],
                                visualizations: [ { type: #AS_LINEITEM } ] } ],
       // tab of the app's list page (manifest views, 2026-10-10)
       selectionVariant: [ { qualifier: 'Tab', text: 'Inward' } ] }
annotate entity ZMM_CH_IMGVR with
{
  @UI.facet: [ { id: 'Status', purpose: #HEADER, type: #FIELDGROUP_REFERENCE,
                 targetQualifier: 'Status', position: 10 },
               { id: 'General', purpose: #STANDARD, type: #COLLECTION,
                 label: 'Gate Entry', position: 10 },
               { id: 'Gate', parentId: 'General', type: #FIELDGROUP_REFERENCE,
                 targetQualifier: 'Gate', label: 'Gate Entry', position: 10 },
               { id: 'Weigh', parentId: 'General', type: #FIELDGROUP_REFERENCE,
                 targetQualifier: 'Weigh', label: 'Weighment', position: 20 },
               { id: 'Verify', parentId: 'General', type: #FIELDGROUP_REFERENCE,
                 targetQualifier: 'Verify', label: 'Verification', position: 30 },
               { id: 'Images', purpose: #STANDARD, type: #LINEITEM_REFERENCE,
                 label: 'Camera Images', targetElement: '_Stages', position: 20 } ]

  @UI.hidden: true
  Uuid;

  @UI.lineItem: [ { position: 10, label: 'Gate Entry No' },
                  { type: #FOR_ACTION, dataAction: 'Approve', label: 'Approve', position: 10 },
                  { type: #FOR_ACTION, dataAction: 'Reject', label: 'Reject', position: 20 } ]
//  @UI.identification: [ { type: #FOR_ACTION, dataAction: 'Approve', label: 'Approve', position: 10 },
//                        { type: #FOR_ACTION, dataAction: 'Reject', label: 'Reject', position: 20 } ]
  @UI.fieldGroup: [ { qualifier: 'Gate', position: 10, label: 'Gate Entry No' } ]
  @UI.selectionField: [ { position: 20 } ]
  @EndUserText.label: 'Gate Entry No'
  Gateentryno;

  @UI.lineItem: [ { position: 20, label: 'Gate Entry Date' } ]
  @UI.fieldGroup: [ { qualifier: 'Gate', position: 20, label: 'Gate Entry Date' } ]
  @UI.selectionField: [ { position: 40 } ]
  @EndUserText.label: 'Gate Entry Date'
  Gateentrydate;

  @UI.fieldGroup: [ { qualifier: 'Gate', position: 30, label: 'Series' } ]
  Gateentryseries;

  @UI.hidden: true
  Gateentryseriesdes;

  @UI.fieldGroup: [ { qualifier: 'Gate', position: 40, label: 'Plant' } ]
  @UI.selectionField: [ { position: 50 } ]
  @EndUserText.label: 'Plant'
  Plant;

  @UI.hidden: true
  Plantname;

  @UI.lineItem: [ { position: 30, label: 'Vehicle No' } ]
  @UI.fieldGroup: [ { qualifier: 'Gate', position: 50, label: 'Vehicle No' } ]
  @UI.selectionField: [ { position: 30 } ]
  @EndUserText.label: 'Vehicle No'
  Vehicleno;

  @UI.fieldGroup: [ { qualifier: 'Gate', position: 60, label: 'Transporter' } ]
  Transportname;

  @UI.fieldGroup: [ { qualifier: 'Gate', position: 70, label: 'Driver' } ]
  Drivername;

  @UI.lineItem: [ { position: 40, label: 'Challan No' } ]
  @UI.fieldGroup: [ { qualifier: 'Gate', position: 80, label: 'Challan No' } ]
  Challanno;

  @UI.lineItem: [ { position: 70, label: 'Weighbridge' } ]
  @UI.fieldGroup: [ { qualifier: 'Weigh', position: 10, label: 'Weighbridge' } ]
  Weighmentmcno;

  @UI.hidden: true
  Weighmentmcndes;

  @UI.fieldGroup: [ { qualifier: 'Weigh', position: 20, label: 'Gross Weight' } ]
  Grosswt;

  @UI.hidden: true
  Weighuom;

  @UI.fieldGroup: [ { qualifier: 'Weigh', position: 30, label: 'Weighment Date' } ]
