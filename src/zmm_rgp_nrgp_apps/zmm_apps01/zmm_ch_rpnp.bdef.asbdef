projection;
strict ( 2 );
use draft;
use side effects;

define behavior for ZMM_CH_RPNP alias _Header
{
  use create;
  use update;
  use delete;

  use action MaterialInput;
  use action checked;
  use action printout;
  use action RGP_NRGP_number;

  use action Resume;
  use action Edit;
  use action Activate;
  use action Discard;
  use action Prepare;

  use association _Item1 { create; with draft; }
}

define behavior for ZMM_CI_RPNP alias _Item
{
  use update;
  use delete;

  use association _Header { with draft; }
}